{
  "manifest_version": 3,
  "name": "AI Screen Reader",
  "version": "0.1.0",
  "description": "Premium AI Screen Reader, Article Reader, Document & PDF File Reader. Convert screen text to speech using natural AI voices.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "offscreen",
    "contextMenus",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.fish.audio/*",
    "file:///*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Screen Reader — listen to this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-play": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Play / pause reading"
    },
    "read-selection": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Read the current selection"
    }
  }
}
